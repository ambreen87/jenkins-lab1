pipeline {
    agent any
    tools {
        jdk 'JDK-21'
        maven 'Maven-3.9.9'
    }
    
    options {
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        timestamps()

        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        choice(
            name: 'cloud',
            choices: ['dev', 'sit', 'bat', 'nft', 'ite', 'prod'],
            description: 'Environment to deploy to'
        )

        text(
            name: 'aws',
            defaultValue: '',
            description: 'Release notes for this deployment.'
        )

        
    }
    environment {
        APP_NAME = 'my-app'
        ENV = "${params.cloud}"
        NOTES = "${params.aws}"
        TEST = "new"      
        DATETIME = "${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        NUMB = " "
    }
    stages {
        stage('Checkout') {
            steps {
                echo "Checking out source code..."
                dir('sample-git-repo') {
                    git branch: 'main', url: 'https://github.com/ambreen87/jenkins-pipeline.git'
                }
                dir('test-repo') {
                    git branch: 'daily-work', url: 'https://github.com/ambreen87/daily-work.git'
                }                
            }
        }
        stage('update-git') {
            steps {
                echo "updating the source code..."
                
                dir('test-repo') {
                    bat '''
							git config --global user.email "amberambreen01@gmail.com"
							git config --global user.name "ambreen87"
				
					        echo Hello from Jenkins > jenkins-file.txt
					
					        git add jenkins-file.txt
					        git commit -m "Add file from Jenkins"
					        git push 
					    '''
                }                
            }
        }
        stage('Test') {            
            steps {
                script {
                    echo "This is Test stage"
                    echo "You selected ENVIRONMENT is = ${ENV}"
                    echo "You selected NUMBER is = ${NUMB}"
                    echo "You selected  = ${NOTES}"
                    echo "You selected  is = ${TEST}"
                    echo "You selected app is = ${APP_NAME}"
                    echo "You selected date and time is = ${DATETIME}"
                    NUMB = "helo jenkins"
                    echo "You selected NUMBER is = ${NUMB}"
                
                }
            }
        }
        stage('exam') {            
            steps {
                script {
                    echo "This is exam stage"
                    echo "You selected NUMBER is = ${NUMB}"
                    
                }
            }
        }
        stage('final') {            
            steps {
                script {
                    echo "This is final stage"
                    
                }
            }
        }
    }
    post {

        // Runs if pipeline succeeds
        success {
            echo 'Pipeline completed successfully.'
        }

        // Runs if pipeline fails
        failure {
            echo 'Pipeline failed.'
        }

        // Runs if pipeline is unstable
        unstable {
            echo 'Pipeline is unstable.'
        }

        // Runs if pipeline is aborted
        aborted {
            echo 'Pipeline was aborted.'
        }

        // Runs regardless of result
        always {
            echo "Build result: ${currentBuild.currentResult}"
            
        }

        // Runs when result changes from previous build
        changed {
            echo 'Build result changed.'
        }

        // Runs when build succeeds for the first time
        fixed {
            echo 'Build is fixed.'
        }

        // Runs when a previously successful build starts failing
        regression {
            echo 'Build has regressed.'
        }
    }
   
}
