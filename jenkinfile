pipeline {
    agent any
    tools {
        jdk 'JDK-21'
        maven 'Maven-3.9.9'
    }
    
    options {
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        timestamps()

        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'sit', 'bat', 'nft', 'ite', 'prod'],
            description: 'Environment to deploy to'
        )

        text(
            name: 'NOTES',
            defaultValue: '',
            description: 'Release notes for this deployment.'
        )

        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run unit tests'
        )
    }
    environment {
        APP_NAME = 'my-app'
        ENV = "${params.ENVIRONMENT}"
        NOTES = "${params.NOTES}"
        TEST = "${params.RUN_TESTS}"      
        DATETIME = "${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        NUMB = " "
    }
    stages {
        stage('Checkout') {
            steps {
                echo "Checking out source code..."
                dir('sample-git-repo') {
                    git branch: 'main', url: 'https://github.com/ambreen87/jenkins-pipeline.git'
                }
                dir('test-repo') {
                    git branch: 'daily-work', url: 'https://github.com/ambreen87/daily-work.git'
                }                
            }
        }
        stage('Trigger another-pipeline') {
            steps {
                script {
                    echo "Triggering downstream another-pipeline..."

                    def downstreamBuild = build(
                        job: 'another-pipeline',
                        wait: true,
                        propagate: false,
                        parameters: [
                            string(
                                name: 'cloud',
                                value: params.ENVIRONMENT
                            ),
                            string(
                                name: 'aws',
                                value: params.NOTES
                            )
                        ]
                    )

                    echo "======================================"
                    echo "Downstream Job: another-pipeline"
					echo "Downstream data: ${downstreamBuild}"
                    echo "Build Number: ${downstreamBuild.number}"
                    echo "Build Result: ${downstreamBuild.result}"
                    echo "Build URL: ${downstreamBuild.absoluteUrl}"
                    echo "======================================"

                    if (downstreamBuild.result == 'SUCCESS') {
                        echo "another-pipeline completed successfully"

                    } else {
                        echo "another-pipeline failed with status: ${downstreamBuild.result}"
                        
                    }
                }
            }
        }
        stage('Test') {            
            steps {
                script {
                    echo "This is Test stage"
                    echo "You selected ENVIRONMENT is = ${ENV}"
                    echo "You selected NUMBER is = ${NUMB}"
                    echo "You selected  = ${NOTES}"
                    echo "You selected  is = ${TEST}"
                    echo "You selected app is = ${APP_NAME}"
                    echo "You selected date and time is = ${DATETIME}"
                    NUMB = "helo jenkins"
                    echo "You selected NUMBER is = ${NUMB}"
                
                }
            }
        }
        stage('exam') {            
            steps {
                script {
                    echo "This is exam stage"
                    echo "You selected NUMBER is = ${NUMB}"
                    
                }
            }
        }
        stage('final') {            
            steps {
                script {
                    echo "This is final stage"
                    
                }
            }
        }
    }
    post {

        // Runs if pipeline succeeds
        success {
            echo 'Pipeline completed successfully.'
        }

        // Runs if pipeline fails
        failure {
            echo 'Pipeline failed.'
        }

        // Runs if pipeline is unstable
        unstable {
            echo 'Pipeline is unstable.'
        }

        // Runs if pipeline is aborted
        aborted {
            echo 'Pipeline was aborted.'
        }

        // Runs regardless of result
        always {
            echo "Build result: ${currentBuild.currentResult}"
            
        }

        // Runs when result changes from previous build
        changed {
            echo 'Build result changed.'
        }

        // Runs when build succeeds for the first time
        fixed {
            echo 'Build is fixed.'
        }

        // Runs when a previously successful build starts failing
        regression {
            echo 'Build has regressed.'
        }
    }
   
}
