pipeline {
    agent any
    tools {
        jdk 'JDK-21'
        maven 'Maven-3.9.9'
    }
    triggers {
        cron('* * * * *')
    }
    options {
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        timestamps()

        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'sit', 'bat', 'nft', 'ite', 'prod'],
            description: 'Environment to deploy to'
        )

        text(
            name: 'NOTES',
            defaultValue: '',
            description: 'Release notes for this deployment.'
        )

        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run unit tests'
        )
    }
    environment {
        APP_NAME = 'my-app'
        ENV = "${params.ENVIRONMENT}"
        NOTES = "${params.NOTES}"
        TEST = "${params.RUN_TESTS}"
    }
    stages {
        stage('Test') {            
            steps {
                script {
                    echo "This is Test stage"
                    echo "You selected ENVIRONMENT is = ${ENV}"
                    echo "You selected ENVIRONMENT is = ${params.ENVIRONMENT}"
                    
                }
            }
        } 
        stage('exam') {            
            steps {
                script {
                    echo "This is exam stage"
                    
                }
            }
        }
        stage('final') {            
            steps {
                script {
                    echo "This is final stage"
                    
                }
            }
        }
    }
}
